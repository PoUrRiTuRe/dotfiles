#!/usr/bin/env bash
# game-mode — toggle Serpantinum's performance mode (SUPER + G)
# On:  no quick actions panel on the screen edges (it opens over games),
#      no desktop widgets, no animated wallpaper, no idle actions
# Off: everything back, including the pomodoro timer of the quick actions
# Usage: game-mode [on|off]   (no argument = toggle)
set -uo pipefail

SETTINGS="$HOME/.config/serpantinum/settings.json"
[[ -f "$SETTINGS" ]] || { echo "!! $SETTINGS not found"; exit 1; }

state=$(python3 - "$SETTINGS" "${1:-toggle}" << 'PY'
import json, os, sys
path, wanted = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    data = json.load(f)
general = data.setdefault("general", {})
current = bool(general.get("performance", False))
new = {"on": True, "off": False}.get(wanted, not current)
general["performance"] = new
# Write to a temporary file then rename: Serpantinum watches this file
tmp = path + ".tmp-game-mode"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
os.replace(tmp, path)
print("on" if new else "off")
PY
) || { echo "!! Could not update $SETTINGS"; exit 1; }

if [[ "$state" == "on" ]]; then
    msg="Game mode ON: screen edges are free"
else
    msg="Game mode OFF: quick actions and widgets are back"
fi
echo "$msg"
command -v notify-send >/dev/null && notify-send -a "Game mode" "$msg"
exit 0
