#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────
#  keybinds-menu — searchable list of every shortcut (SUPER + K)
#  Hyprland binds come from `hyprctl binds -j` (their "description"
#  option in keybinds.lua), kitty / zsh shortcuts from
#  ~/.config/hypr/keybinds-extra.tsv. Shown with fuzzel (Nebula theme in
#  ~/.config/fuzzel/fuzzel.ini): type any word of the keys or description.
# ─────────────────────────────────────────────────────────────
import json, os, shutil, subprocess, sys

EXTRA = os.path.expanduser("~/.config/hypr/keybinds-extra.tsv")

# Modifier bits of `hyprctl binds -j` (modmask), in display order
MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]

PRETTY = {
    "left": "←", "right": "→", "up": "↑", "down": "↓",
    "return": "ENTER", "escape": "ESC", "tab": "TAB", "space": "SPACE",
    "print": "PRINT", "mouse:272": "LEFT CLICK", "mouse:273": "RIGHT CLICK",
    "xf86audioraisevolume": "VOL +", "xf86audiolowervolume": "VOL −",
    "xf86audiomute": "MUTE", "xf86audiomicmute": "MIC MUTE",
    "xf86audioplay": "PLAY", "xf86audiopause": "PAUSE",
    "xf86audionext": "NEXT", "xf86audioprev": "PREV",
    "xf86monbrightnessup": "BRIGHT +", "xf86monbrightnessdown": "BRIGHT −",
    "xf86poweroff": "POWER", "lid switch": "LID CLOSED",
}


def pretty_key(key):
    key = key.split(":", 2)[-1] if key.startswith("switch:") else key
    return PRETTY.get(key.lower(), key.upper())


def hypr_binds():
    try:
        out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, check=True).stdout
        binds = json.loads(out)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return []
    entries = []
    for b in binds:
        desc = b.get("description") or ""
        if not desc:
            continue
        keys = [name for bit, name in MODS if b.get("modmask", 0) & bit]
        keys.append(pretty_key(b.get("key") or ""))
        entries.append((" + ".join(keys), desc))
    return entries


def extra_binds():
    entries = []
    try:
        with open(EXTRA, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\n")
                if not line or line.startswith("#") or "\t" not in line:
                    continue
                keys, desc = line.split("\t", 1)
                keys = " + ".join(pretty_key(k.strip()) for k in keys.split("+"))
                entries.append((keys, desc))
    except OSError:
        pass
    return entries


def main():
    entries = hypr_binds() + extra_binds()
    if not entries:
        sys.exit("!! No shortcuts found (is Hyprland running?)")

    lines = []
    for keys, desc in entries:
        section, _, text = desc.partition(": ")
        if not text:
            section, text = "", desc
        lines.append(f"{keys:<26}  {section:<12}  {text}")

    if not shutil.which("fuzzel"):
        print("\n".join(lines))
        sys.exit("!! fuzzel is not installed: sudo pacman -S fuzzel")

    # Show only: the menu is a reminder, selecting a line does nothing
    subprocess.run(["fuzzel", "--dmenu"], input="\n".join(lines), text=True)


if __name__ == "__main__":
    main()
