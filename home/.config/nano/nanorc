## Nano — Nebula colors
## (colors as #RGB: 3 hex digits)

# Title bar: dark text on cyan
set titlecolor bold,#012,#0ef
# Info messages: white text on purple
set statuscolor bold,#fff,#52a
# Error messages: white text on dark red (readable!)
set errorcolor bold,#fff,#b02
# Bottom prompt (file name, etc.): dark text on cyan
set promptcolor #012,#0ef
# Bottom shortcuts: key in cyan, description in white
set keycolor bold,#0ef
set functioncolor #fff
# Selected text and search results
set selectedcolor #012,#f2d
set spotlightcolor #012,#fe6
# Line numbers and scrollbar
set numbercolor #b9f
set scrollercolor #0ef

# Comfort
set linenumbers
set mouse
set indicator

# Syntax highlighting (sh, conf, java, lua…)
include "/usr/share/nano/*.nanorc"
